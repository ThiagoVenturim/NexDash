# Copy to .env and fill in. .env is ignored by git.

# Required for the REST API, POST /mcp and the web UI (at least 16 characters).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEXDASH_API_TOKEN=

# Local demos only: allow requests without a token when NEXDASH_API_TOKEN is empty.
# NEXDASH_ALLOW_ANONYMOUS=1

# Report engine clients: one token per consuming project, with its scopes
# (reports:list, reports:run, semantic:read, semantic:query, semantic:ask).
# NEXDASH_CLIENT_NEXCODER_TOKEN=
# NEXDASH_CLIENT_NEXCODER_SCOPES=reports:list,reports:run

# Register the report models (dev_productivity, security_posture, support_metrics).
# NEXDASH_REPORT_MODELS=1

# Database (defaults to in-memory SQLite).
# DB_URL=sqlite:///nexdash.db

# Cube YAML directory and synthetic demo cubes.
# NEXDASH_CUBES_DIR=./cubes
# NEXDASH_DEMO=1

# nexcoder-core model tier used for natural-language questions: small, medium or large.
# NEXDASH_LLM_TIER=medium
